+"use client";
+
+import { useEffect, useState } from "react";
+import {
+  MAX_ABOUT_CHARS,
+  MAX_AGE,
+  MAX_DISPLAY_NAME_CHARS,
+  MAX_NICKNAME_CHARS,
+  MAX_OCCUPATION_CHARS,
