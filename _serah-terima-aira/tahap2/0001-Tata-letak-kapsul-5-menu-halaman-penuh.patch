 @import "tailwindcss";
 
+/* =====================================================================
+ * Dasar
+ * ===================================================================== */
+
 html,
 body {
   height: 100%;
 }
 
+/*
+ * Font: pakai font sistem. Di iPhone ini otomatis San Francisco — terlihat
+ * paling "asli" di perangkatnya, dan tidak perlu mengunduh apa pun.
+ */
+:root {
+  --font-ui: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, Roboto,
+    "Helvetica Neue", Arial, sans-serif;
+
+  /* Ruang untuk kapsul navigasi bawah (dipakai padding konten). */
+  --tabbar-space: calc(4.75rem + env(safe-area-inset-bottom, 0px));
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+  text-size-adjust: 100%;
+  -webkit-tap-highlight-color: transparent;
+}
+
+body {
+  font-family: var(--font-ui);
+  overscroll-behavior-y: none;
+}
+
+/*
+ * Cegah iOS Safari memperbesar halaman saat kolom diisi.
+ *
+ * Safari otomatis zoom kalau font kolom < 16px. Dulu beberapa kolom memakai
+ * text-sm (14px), jadi setiap kali mengetik halaman ikut membesar dan tidak
+ * kembali sendiri. Ditulis di luar @layer supaya menang dari utility Tailwind.
+ */
+@media (pointer: coarse) {
+  input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not([type="range"]),
+  textarea,
+  select {
+    font-size: 16px;
+    line-height: 1.4;
+  }
+}
+
+/*
+ * Kontrol form di iOS punya lebar bawaan yang bisa melebihi layar dan membuat
+ * halaman bisa digeser ke samping. Paksa mengikuti wadahnya.
+ */
+input,
+textarea,
+select {
+  min-width: 0;
+  max-width: 100%;
+}
+
+/* Di layar HP, teks kecil dinaikkan satu tingkat agar mudah dibaca. */
+@media (max-width: 767px) {
+  :root {
+    --text-xs: 0.8125rem; /* 13px */
+    --text-sm: 0.9375rem; /* 15px */
+  }
+}
+
+/* =====================================================================
+ * Kapsul navigasi
+ * ===================================================================== */
+
+/*
+ * Kaca: latar setengah tembus pandang + blur, tanpa garis tepi, dengan
+ * bayangan lembut supaya terlihat mengambang di atas konten.
+ */
+.glass-capsule {
+  background-color: rgba(255, 255, 255, 0.92);
+  box-shadow:
+    0 12px 32px -12px rgba(15, 23, 42, 0.35),
+    0 2px 10px -4px rgba(15, 23, 42, 0.18);
+}
+
+@supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
+  .glass-capsule {
+    background-color: rgba(255, 255, 255, 0.62);
+    -webkit-backdrop-filter: saturate(180%) blur(22px);
+    backdrop-filter: saturate(180%) blur(22px);
+  }
+}
+
+/*
+ * Kapsul disembunyikan saat keyboard aktif: kelas di <html> dipasang oleh
+ * composer saat kolom ketik difokuskan.
+ */
+.mobile-tabbar {
+  transition: opacity 0.18s ease, transform 0.18s ease;
+}
+
+html.kb-open .mobile-tabbar {
+  opacity: 0;
+  transform: translateY(120%);
+  pointer-events: none;
+}
+
+/* =====================================================================
+ * Scrollbar
+ * ===================================================================== */
+
 * {
   scrollbar-width: thin;
   scrollbar-color: rgba(0, 0, 0, 0.18) transparent;
