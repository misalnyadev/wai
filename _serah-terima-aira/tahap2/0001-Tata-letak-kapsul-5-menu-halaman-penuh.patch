new file mode 100644
index 0000000..5737270
--- /dev/null
+++ b/src/components/CharactersView.tsx
@@ -0,0 +1,79 @@
+"use client";
+
+import type { CharacterSummary } from "@/types/chat";
+import { Avatar } from "./Avatar";
+import { PageShell } from "./PageShell";
+import { PlusIcon } from "./icons";
+
+export function CharactersView({
+  characters,
+  limit,
+  onOpen,
+  onCreate,
+}: {
+  characters: CharacterSummary[];
+  limit: number;
+  onOpen: (id: string) => void;
+  onCreate: () => void;
+}) {
+  const full = characters.length >= limit;
+
+  return (
+    <PageShell
+      title="Karakter"
+      subtitle={`${characters.length} dari ${limit} karakter`}
+      action={
+        <button
+          onClick={onCreate}
+          disabled={full}
+          className="flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-40"
+          title={full ? `Maksimal ${limit} karakter` : "Buat karakter baru"}
+        >
+          <PlusIcon className="h-4 w-4" />
+          Baru
+        </button>
+      }
+    >
+      {characters.length === 0 ? (
+        <div className="rounded-2xl bg-white p-8 text-center ring-1 ring-slate-200">
+          <p className="text-sm text-slate-500">Belum ada karakter.</p>
+          <button
+            onClick={onCreate}
+            className="mt-3 rounded-full bg-emerald-600 px-4 py-2 text-xs font-semibold text-white"
+          >
+            Buat karakter pertama
+          </button>
+        </div>
+      ) : (
+        <div className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
+          {characters.map((c) => (
+            <button
+              key={c.id}
+              onClick={() => onOpen(c.id)}
+              className="flex flex-col items-center gap-2 rounded-2xl bg-white p-4 text-center ring-1 ring-slate-200 transition active:scale-[0.98] hover:ring-emerald-300"
+            >
+              <Avatar name={c.name} src={c.avatarUrl} size={64} />
+              <div className="w-full min-w-0">
+                <p className="truncate text-sm font-semibold text-slate-900">
+                  {c.name}
+                  {c.hasBible && (
+                    <span className="ml-1 text-[11px]" title="Punya bible peran">
+                      📖
+                    </span>
+                  )}
+                </p>
+                {c.shortBio && <p className="truncate text-[11px] text-slate-400">{c.shortBio}</p>}
+              </div>
+            </button>
+          ))}
+        </div>
+      )}
+
+      {full && (
+        <p className="mt-3 text-center text-[11px] text-slate-400">
+          Sudah {limit} karakter — batas maksimal. Hapus salah satu untuk menambah lagi.
+        </p>
+      )}
+    </PageShell>
+  );
+}
