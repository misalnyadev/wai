diff --git a/src/components/Navigation.tsx b/src/components/Navigation.tsx
new file mode 100644
index 0000000..ee78e33
--- /dev/null
+++ b/src/components/Navigation.tsx
@@ -0,0 +1,127 @@
+"use client";
+
+import { Avatar } from "./Avatar";
+import {
+  ChatsIcon,
+  GridIcon,
+  SettingsIcon,
+  SpeakerIcon,
+  UserIcon,
+} from "./icons";
+
+export type AppView = "chats" | "characters" | "voice" | "profile" | "settings";
+
+const ITEMS: {
+  view: AppView;
+  label: string;
+  Icon: (p: { className?: string }) => React.JSX.Element;
+}[] = [
+  { view: "chats", label: "Chat", Icon: ChatsIcon },
+  { view: "characters", label: "Karakter", Icon: GridIcon },
+  { view: "voice", label: "Suara", Icon: SpeakerIcon },
+  { view: "profile", label: "Profil", Icon: UserIcon },
+  { view: "settings", label: "Setelan", Icon: SettingsIcon },
+];
+
+/** Rail navigasi samping untuk layar lebar. */
+export function NavRail({
+  view,
+  onChange,
+  userName,
+  avatarUrl,
+}: {
+  view: AppView;
+  onChange: (view: AppView) => void;
+  userName: string;
+  avatarUrl?: string | null;
+}) {
+  return (
+    <nav className="hidden w-[76px] shrink-0 flex-col items-center gap-0.5 bg-[#f0f2f5] py-3 md:flex">
+      <button
+        onClick={() => onChange("profile")}
+        className="mb-2 rounded-full ring-2 ring-transparent transition hover:ring-slate-300"
+        title={userName ? `Profil: ${userName}` : "Isi profilmu"}
+        aria-label="Profil saya"
+      >
+        <Avatar name={userName || "Kamu"} src={avatarUrl} size={40} />
+      </button>
+
+      {ITEMS.map(({ view: item, label, Icon }) => {
+        const active = view === item;
+        return (
+          <button
+            key={item}
+            onClick={() => onChange(item)}
+            title={label}
+            aria-label={label}
+            aria-current={active}
+            className="group flex w-full flex-col items-center gap-1 py-1.5"
+          >
+            <span
+              className={`flex h-10 w-10 items-center justify-center rounded-full transition ${
+                active
+                  ? "bg-slate-900/10 text-slate-900"
+                  : "text-slate-500 group-hover:bg-slate-200/70 group-hover:text-slate-900"
+              }`}
+            >
+              <Icon className="h-5 w-5" />
+            </span>
+            <span
+              className={`text-[11px] font-medium ${active ? "text-slate-900" : "text-slate-500"}`}
+            >
+              {label}
+            </span>
+          </button>
+        );
+      })}
+    </nav>
+  );
+}
+
+/**
+ * Kapsul navigasi bawah untuk HP.
+ *
+ * `fixed` + blur supaya isi halaman terlihat lewat di belakang kaca. Konten
+ * yang bisa digulir diberi padding bawah `--tabbar-space` agar tidak tertutup,
+ * dan kapsul disembunyikan saat keyboard aktif (lihat globals.css).
+ */
+export function MobileTabBar({
+  view,
+  onChange,
+}: {
+  view: AppView;
+  onChange: (view: AppView) => void;
+}) {
+  return (
+    <div className="mobile-tabbar pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center px-4 pb-[max(0.5rem,calc(env(safe-area-inset-bottom)-0.4rem))] md:hidden">
+      <nav
+        aria-label="Navigasi utama"
+        className="glass-capsule pointer-events-auto flex w-full max-w-[440px] items-center gap-0.5 rounded-full p-1.5"
+      >
+        {ITEMS.map(({ view: item, label, Icon }) => {
+          const active = view === item;
+          return (
+            <button
+              key={item}
+              onClick={() => onChange(item)}
+              aria-current={active}
+              aria-label={label}
+              className={`flex min-w-0 flex-1 flex-col items-center gap-0.5 rounded-full px-0.5 py-2 transition active:scale-[0.97] ${
+                active ? "bg-slate-900/10 text-slate-900" : "text-slate-500"
+              }`}
+            >
+              <Icon className={`h-[22px] w-[22px] ${active ? "stroke-[2.2]" : ""}`} />
+              <span
+                className={`truncate text-[11px] leading-none ${
+                  active ? "font-semibold" : "font-medium"
+                }`}
+              >
+                {label}
+              </span>
+            </button>
+          );
+        })}
+      </nav>
+    </div>
+  );
+}
diff --git a/src/components/PageShell.tsx b/src/components/PageShell.tsx
new file mode 100644
index 0000000..cb45e2d
--- /dev/null
+++ b/src/components/PageShell.tsx
@@ -0,0 +1,40 @@
+"use client";
+
+import type { ReactNode } from "react";
+
+/**
+ * Bingkai halaman untuk menu non-chat.
+ *
+ * Padding bawah memakai `--tabbar-space` supaya isi terakhir tidak tertutup
+ * kapsul navigasi. Padding atas memakai `env(safe-area-inset-top)` supaya
+ * judul tidak tertimpa jam/baterai iPhone.
+ */
+export function PageShell({
+  title,
+  subtitle,
+  action,
+  children,
+}: {
+  title: string;
+  subtitle?: string;
+  action?: ReactNode;
+  children: ReactNode;
+}) {
+  return (
+    <div className="flex h-full min-w-0 w-full flex-1 flex-col bg-slate-50">
+      <header className="shrink-0 border-b border-slate-200 bg-white px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] md:px-6 md:pt-5">
+        <div className="flex items-start justify-between gap-3">
+          <div className="min-w-0">
+            <h1 className="truncate text-lg font-bold text-slate-900 md:text-xl">{title}</h1>
+            {subtitle && <p className="mt-0.5 text-xs text-slate-500">{subtitle}</p>}
+          </div>
+          {action}
+        </div>
+      </header>
+
+      <div className="flex-1 overflow-y-auto px-4 pb-[calc(var(--tabbar-space)+0.5rem)] pt-3 md:px-6">
+        {children}
+      </div>
+    </div>
+  );
+}
