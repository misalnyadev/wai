diff --git a/src/components/ProfileView.tsx b/src/components/ProfileView.tsx
new file mode 100644
index 0000000..3af2356
--- /dev/null
+++ b/src/components/ProfileView.tsx
@@ -0,0 +1,172 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import {
+  MAX_ABOUT_CHARS,
+  MAX_AGE,
+  MAX_DISPLAY_NAME_CHARS,
+  MAX_NICKNAME_CHARS,
+  MAX_OCCUPATION_CHARS,
+  MIN_AGE,
+} from "@/lib/limits";
+import type { UserProfile } from "@/lib/userProfile";
+import { PageShell } from "./PageShell";
+
+const EMPTY: UserProfile = {
+  displayName: "",
+  nickname: "",
+  age: null,
+  occupation: "",
+  about: "",
+};
+
+export function ProfileView() {
+  const [profile, setProfile] = useState<UserProfile>(EMPTY);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [saved, setSaved] = useState(false);
+
+  useEffect(() => {
+    let alive = true;
+    fetch("/api/profile", { cache: "no-store" })
+      .then((res) => res.json())
+      .then((data) => {
+        if (alive && data?.profile) setProfile({ ...EMPTY, ...data.profile });
+      })
+      .catch(() => undefined)
+      .finally(() => {
+        if (alive) setLoading(false);
+      });
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  function set<K extends keyof UserProfile>(key: K, value: UserProfile[K]) {
+    setProfile((prev) => ({ ...prev, [key]: value }));
+    setSaved(false);
+  }
+
+  async function handleSubmit(e: React.FormEvent) {
+    e.preventDefault();
+    setError(null);
+    setBusy(true);
+    try {
+      const res = await fetch("/api/profile", {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(profile),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error || "Gagal menyimpan profil.");
+      setProfile({ ...EMPTY, ...data.profile });
+      setSaved(true);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Terjadi kesalahan.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const counter = (value: string, max: number) => (
+    <span className={`text-[11px] ${value.length > max ? "text-rose-600" : "text-slate-400"}`}>
+      {value.length}/{max}
+    </span>
+  );
+
+  return (
+    <PageShell title="Profil Saya" subtitle="Dibaca semua karakter sebelum membalas">
+      {loading ? (
+        <p className="py-10 text-center text-sm text-slate-400">Memuat profil...</p>
+      ) : (
+        <form onSubmit={handleSubmit} className="mx-auto max-w-xl space-y-3">
+          <p className="rounded-xl bg-emerald-50 px-3 py-2 text-xs leading-relaxed text-emerald-800">
+            Semua karakter membacanya sebelum membalas, jadi mereka tahu sedang ngobrol dengan siapa
+            dan memanggilmu dengan benar. Tidak wajib diisi.
+          </p>
+
+          <Field label="Nama" hint={counter(profile.displayName, MAX_DISPLAY_NAME_CHARS)}>
+            <input
+              value={profile.displayName}
+              onChange={(e) => set("displayName", e.target.value)}
+              placeholder="Mis. Hana"
+              className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-emerald-400"
+            />
+          </Field>
+
+          <div className="grid grid-cols-2 gap-2">
+            <Field label="Panggilan sehari-hari" hint={counter(profile.nickname, MAX_NICKNAME_CHARS)}>
+              <input
+                value={profile.nickname}
+                onChange={(e) => set("nickname", e.target.value)}
+                placeholder="Mis. Han"
+                className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-emerald-400"
+              />
+            </Field>
+            <Field label="Usia" hint={`${MIN_AGE}–${MAX_AGE}`}>
+              <input
+                type="number"
+                inputMode="numeric"
+                min={MIN_AGE}
+                max={MAX_AGE}
+                value={profile.age ?? ""}
+                onChange={(e) => set("age", e.target.value === "" ? null : Number(e.target.value))}
+                placeholder="Mis. 27"
+                className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-emerald-400"
+              />
+            </Field>
+          </div>
+
+          <Field label="Kesibukan" hint={counter(profile.occupation, MAX_OCCUPATION_CHARS)}>
+            <input
+              value={profile.occupation}
+              onChange={(e) => set("occupation", e.target.value)}
+              placeholder="Mis. kerja di studio foto, sering lembur"
+              className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-emerald-400"
+            />
+          </Field>
+
+          <Field label="Cerita tentang dirimu" hint={counter(profile.about, MAX_ABOUT_CHARS)}>
+            <textarea
+              value={profile.about}
+              onChange={(e) => set("about", e.target.value)}
+              rows={5}
+              placeholder="Kebiasaanmu, hal yang sedang kamu kejar, apa yang bikin kamu capek minggu ini."
+              className="w-full resize-none rounded-lg border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-emerald-400"
+            />
+          </Field>
+
+          {error && <p className="text-sm text-rose-600">{error}</p>}
+          {saved && <p className="text-sm font-medium text-emerald-600">Profil tersimpan.</p>}
+
+          <button
+            type="submit"
+            disabled={busy}
+            className="w-full rounded-lg bg-emerald-600 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-60"
+          >
+            {busy ? "Menyimpan..." : "Simpan Profil"}
+          </button>
+        </form>
+      )}
+    </PageShell>
+  );
+}
+
+function Field({
+  label,
+  hint,
+  children,
+}: {
+  label: string;
+  hint?: React.ReactNode;
+  children: React.ReactNode;
+}) {
+  return (
+    <label className="block">
+      <span className="mb-1 block text-xs font-medium text-slate-600">{label}</span>
+      {children}
+      {hint && <span className="mt-1 block">{hint}</span>}
+    </label>
+  );
+}
