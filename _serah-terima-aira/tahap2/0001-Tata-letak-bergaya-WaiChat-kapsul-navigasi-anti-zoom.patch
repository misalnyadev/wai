+++ b/src/components/SettingsView.tsx
@@ -0,0 +1,272 @@
+"use client";
+
+import { useState } from "react";
+import type { ProviderSummary } from "@/types/chat";
+import { PROVIDER_META, PROVIDER_ORDER } from "@/lib/ai/providerDefaults";
+import type { ProviderType } from "@/db/schema";
+import { useAuth } from "./AuthGate";
+import { PageShell } from "./PageShell";
+import { CheckIcon, TrashIcon } from "./icons";
+
+export function SettingsView({
+  providers,
+  onRefresh,
+  onOpenProfile,
+}: {
+  providers: ProviderSummary[];
+  onRefresh: () => Promise<void>;
+  onOpenProfile: () => void;
+}) {
+  const { user, signOut } = useAuth();
+
+  const [type, setType] = useState<ProviderType>("gemini");
+  const [label, setLabel] = useState("");
+  const [apiKey, setApiKey] = useState("");
+  const [baseUrl, setBaseUrl] = useState("");
+  const [model, setModel] = useState("");
+  const [isDefault, setIsDefault] = useState(providers.length === 0);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [showForm, setShowForm] = useState(false);
+
+  const meta = PROVIDER_META[type];
+
+  async function handleAdd(e: React.FormEvent) {
+    e.preventDefault();
+    setError(null);
+    if (type === "custom" && !baseUrl.trim()) {
+      setError("Base URL wajib diisi untuk provider custom.");
+      return;
+    }
+    setBusy(true);
+    try {
+      const res = await fetch("/api/providers", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          type,
+          label: label.trim() || meta.name,
+          apiKey: apiKey.trim(),
+          baseUrl: baseUrl.trim(),
+          model: model.trim() || meta.defaultModel,
+          isDefault,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) throw new Error(data.error || "Gagal menambah provider.");
+      setLabel("");
+      setApiKey("");
+      setBaseUrl("");
+      setModel("");
+      setShowForm(false);
+      await onRefresh();
+    } catch (err) {
+      setError(err instanceof Error ? err.message : "Terjadi kesalahan.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  async function handleSetDefault(id: string) {
+    await fetch(`/api/providers/${id}`, {
+      method: "PATCH",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ isDefault: true }),
+    });
+    await onRefresh();
+  }
+
+  async function handleDelete(id: string) {
+    if (!confirm("Hapus API key ini?")) return;
+    await fetch(`/api/providers/${id}`, { method: "DELETE" });
+    await onRefresh();
+  }
+
+  return (
+    <PageShell
+      title="Setelan"
+      subtitle="API key disimpan di akunmu, terpisah dari akun lain"
+      action={
+        <button
+          onClick={() => setShowForm((v) => !v)}
+          className="shrink-0 rounded-full bg-emerald-600 px-3.5 py-2 text-xs font-semibold text-white hover:bg-emerald-700"
+        >
+          {showForm ? "Tutup" : "Tambah key"}
+        </button>
+      }
+    >
+      <div className="mx-auto max-w-xl space-y-4">
+        {/* ---------------- API key ---------------- */}
+        <section>
+          <h2 className="mb-2 px-1 text-xs font-semibold uppercase tracking-wide text-slate-400">
+            API key
+          </h2>
+
+          <div className="space-y-2">
+            {providers.length === 0 && (
+              <p className="rounded-xl bg-amber-50 px-3 py-2.5 text-sm text-amber-800">
+                Belum ada API key. Tambahkan minimal satu supaya karakter bisa membalas chat.
+              </p>
+            )}
+
+            {providers.map((p) => (
+              <div
+                key={p.id}
+                className="flex items-center justify-between gap-2 rounded-xl bg-white px-3 py-2.5 ring-1 ring-slate-200"
+              >
+                <div className="min-w-0">
+                  <div className="flex items-center gap-2">
+                    <span className="truncate text-sm font-medium text-slate-900">{p.label}</span>
+                    {p.isDefault && (
+                      <span className="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">
+                        UTAMA
+                      </span>
+                    )}
+                  </div>
+                  <p className="truncate text-xs text-slate-500">
+                    {PROVIDER_META[p.type]?.name ?? p.type} · {p.model}{" "}
+                    {p.hasKey ? `· ${p.maskedKey}` : "· tanpa key"}
+                  </p>
+                </div>
+                <div className="flex shrink-0 items-center gap-1">
+                  {!p.isDefault && (
+                    <button
+                      onClick={() => handleSetDefault(p.id)}
+                      title="Jadikan utama"
+                      className="rounded-full p-2 text-slate-500 hover:bg-emerald-50 hover:text-emerald-600"
+                    >
+                      <CheckIcon className="h-4 w-4" />
+                    </button>
+                  )}
+                  <button
+                    onClick={() => handleDelete(p.id)}
+                    title="Hapus"
+                    className="rounded-full p-2 text-slate-500 hover:bg-rose-50 hover:text-rose-600"
+                  >
+                    <TrashIcon className="h-4 w-4" />
+                  </button>
+                </div>
+              </div>
+            ))}
+          </div>
+
+          {showForm && (
+            <form
+              onSubmit={handleAdd}
+              className="mt-3 space-y-3 rounded-xl bg-white p-3 ring-1 ring-slate-200"
+            >
+              <div className="grid grid-cols-2 gap-2">
+                {PROVIDER_ORDER.map((t) => (
+                  <button
+                    type="button"
+                    key={t}
+                    onClick={() => setType(t)}
+                    className={`rounded-lg border px-3 py-2.5 text-sm font-medium transition ${
+                      type === t
+                        ? "border-emerald-500 bg-emerald-50 text-emerald-700"
+                        : "border-slate-200 text-slate-600 hover:bg-slate-50"
+                    }`}
+                  >
+                    {PROVIDER_META[t].name}
+                  </button>
+                ))}
+              </div>
+
+              {meta.keyHelpUrl && (
+                <p className="text-xs text-slate-500">
+                  Dapatkan API key di{" "}
+                  <a
+                    href={meta.keyHelpUrl}
+                    target="_blank"
+                    rel="noreferrer"
+                    className="font-medium text-emerald-700 underline"
+                  >
+                    {meta.keyHelpUrl.replace("https://", "")}
+                  </a>
+                </p>
+              )}
+
+              <input
+                value={label}
+                onChange={(e) => setLabel(e.target.value)}
+                placeholder={`Nama label (contoh: ${meta.name})`}
+                className="w-full rounded-lg border border-slate-200 px-3 py-2.5 outline-none focus:border-emerald-400"
+              />
+
+              {type === "custom" && (
+                <input
+                  value={baseUrl}
+                  onChange={(e) => setBaseUrl(e.target.value)}
+                  placeholder="Base URL (contoh: http://localhost:11434/v1)"
+                  className="w-full rounded-lg border border-slate-200 px-3 py-2.5 outline-none focus:border-emerald-400"
+                />
+              )}
+
+              <input
+                value={apiKey}
+                onChange={(e) => setApiKey(e.target.value)}
+                placeholder={type === "custom" ? "API Key (opsional)" : "API Key"}
+                type="password"
+                className="w-full rounded-lg border border-slate-200 px-3 py-2.5 outline-none focus:border-emerald-400"
+              />
+
+              <input
+                value={model}
+                onChange={(e) => setModel(e.target.value)}
+                placeholder={`Model (default: ${meta.defaultModel || "isi manual"})`}
+                className="w-full rounded-lg border border-slate-200 px-3 py-2.5 outline-none focus:border-emerald-400"
+              />
+
+              <label className="flex items-center gap-2 text-sm text-slate-600">
+                <input
+                  type="checkbox"
+                  checked={isDefault}
+                  onChange={(e) => setIsDefault(e.target.checked)}
+                  className="h-4 w-4 rounded border-slate-300"
+                />
+                Jadikan provider utama
+              </label>
+
+              {error && <p className="text-sm text-rose-600">{error}</p>}
+
+              <button
+                type="submit"
+                disabled={busy}
+                className="w-full rounded-lg bg-emerald-600 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700 disabled:opacity-60"
+              >
+                {busy ? "Menyimpan..." : "Simpan Provider"}
+              </button>
+            </form>
+          )}
+        </section>
+
+        {/* ---------------- Akun ---------------- */}
+        <section>
+          <h2 className="mb-2 px-1 text-xs font-semibold uppercase tracking-wide text-slate-400">
+            Akun
+          </h2>
+          <div className="rounded-xl bg-white px-3 py-3 ring-1 ring-slate-200">
+            <p className="truncate text-sm text-slate-700">{user.email}</p>
+            <p className="mt-0.5 text-[11px] text-slate-400">
+              Karakter, riwayat, dan API key di akun ini terpisah dari akun lain.
+            </p>
+            <div className="mt-3 flex items-center gap-2">
+              <button
+                onClick={onOpenProfile}
+                className="rounded-full bg-slate-900 px-3.5 py-2 text-xs font-semibold text-white hover:bg-slate-800"
+              >
+                Profil Saya
+              </button>
+              <button
+                onClick={() => void signOut()}
+                className="rounded-full border border-slate-300 px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
+              >
+                Keluar
+              </button>
+            </div>
+          </div>
+        </section>
+      </div>
+    </PageShell>
+  );
+}
